{
  "name": "@cinatra-ai/email-delivery-agent",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "files": [
    "cinatra"
  ],
  "description": "Owner-controlled email delivery — single ApiNode that calls email_outreach_send_initial_start.",
  "type": "module",
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Email Delivery Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/email-artifacts",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "consumes": [
      {
        "primitive": "email_outreach_send_initial_start",
        "requirement": "required"
      },
      {
        "primitive": "email_outreach_send_initial_status",
        "requirement": "required"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "email-delivery-flow",
    "sourceVersionId": "14875cc4-d56b-4995-ac53-56efbe33daf0",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": true,
    "toolAccess": [],
    "ownerOrgId": null,
    "tools": [
      {
        "name": "recipient_records",
        "module": "./cinatra/tools/recipient-records.mjs"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
